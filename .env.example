# Public URL. Do not add a trailing slash.
PUBLIC_ORIGIN=https://game.luisbenedikt.de

# Loopback port used by Apache, Caddy, or another host reverse proxy.
GAMEPAGE_PORT=8090
HEALTH_TIMEOUT=3s

# COBOL-owned global policy.
# Maintenance mode blocks every launch and makes /readyz return 503.
MAINTENANCE_MODE=false
# The stack is not ready when fewer than this many games are launchable.
MINIMUM_LAUNCHABLE_GAMES=1

# COBOL-owned per-game policy. The defaults preserve the current behavior:
# all four games are enabled, required, and subject to a 2500 ms threshold.
# A slow game remains launchable but a required slow game makes /readyz fail.
TRUMP_ENABLED=true
TRUMP_REQUIRED=true
TRUMP_MAX_LATENCY_MS=2500
GOLF_ENABLED=true
GOLF_REQUIRED=true
GOLF_MAX_LATENCY_MS=2500
RACE_ENABLED=true
RACE_REQUIRED=true
RACE_MAX_LATENCY_MS=2500
MOVIES_ENABLED=true
MOVIES_REQUIRED=true
MOVIES_MAX_LATENCY_MS=2500

# The default layout expects all four repositories to be sibling folders.
TRUMP_REPO_PATH=../TrumpVsShakespeare
GOLF_REPO_PATH=../CrazyMiniGolf
RACE_REPO_PATH=../CrazyRaceGame
MOVIES_REPO_PATH=../MovieSelector

# Trump vs. Shakespeare single-instance room limits.
TVS_ROOM_TTL_SECONDS=7200
TVS_MAX_ROOMS=1000
TVS_MAX_SOCKETS_PER_ROOM=6
TVS_SOCKET_SEND_TIMEOUT_SECONDS=3
TVS_WS_IDLE_TIMEOUT_SECONDS=60
TVS_WS_MESSAGES_PER_WINDOW=40
TVS_WS_RATE_WINDOW_SECONDS=10

# Crazy Race settings. Use 0 for a new circuit after every container restart.
TRACK_SEED=42
RACE_MAX_CONNECTIONS=128
RACE_MAX_ROOMS=1000
RACE_ROOM_TTL_SECONDS=7200

# Movie Selector. WENCKE_SITE_PASSWORD is required and has no default -- it is the
# real Wencke site-access password, kept server-side only (the browser never sees
# it). WENCKE_BASE_URL defaults to the production Wencke instance.
WENCKE_BASE_URL=https://wencke.love
WENCKE_SITE_PASSWORD=
