# Public URL. Do not add a trailing slash.
PUBLIC_ORIGIN=https://game.luisbenedikt.de

# Loopback port used by Apache, Caddy, or another host reverse proxy.
GAMEPAGE_PORT=8090
HEALTH_TIMEOUT=3s

# The default layout expects all four repositories to be sibling folders.
TRUMP_REPO_PATH=../TrumpVsShakespeare
GOLF_REPO_PATH=../CrazyMiniGolf
RACE_REPO_PATH=../CrazyRaceGame

# Trump vs. Shakespeare single-instance room limits.
TVS_ROOM_TTL_SECONDS=7200
TVS_MAX_ROOMS=1000
TVS_MAX_SOCKETS_PER_ROOM=6
TVS_SOCKET_SEND_TIMEOUT_SECONDS=3
TVS_WS_IDLE_TIMEOUT_SECONDS=60
TVS_WS_MESSAGES_PER_WINDOW=40
TVS_WS_RATE_WINDOW_SECONDS=10

# Crazy Race settings. Use 0 for a new circuit after every container restart.
TRACK_SEED=42
RACE_MAX_CONNECTIONS=128
RACE_MAX_ROOMS=1000
RACE_ROOM_TTL_SECONDS=7200
