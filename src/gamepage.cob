WRITE-JAVASCRIPT.
    WRITE JS-LINE FROM '"use strict";'
    WRITE JS-LINE FROM 'const statusNodes = new Map(Array.from(document.querySelectorAll("[data-status]")).map((node) => [node.dataset.status, node]));'
    WRITE JS-LINE FROM 'function setStatus(key, state, latency) {'
    WRITE JS-LINE FROM '  const node = statusNodes.get(key); if (!node) return;'
    WRITE JS-LINE FROM '  node.classList.remove("checking", "up", "down"); node.classList.add(state === "up" ? "up" : "down");'
    WRITE JS-LINE FROM '  const label = node.querySelector("[data-status-text]"); if (label) label.textContent = state === "up" ? `ONLINE${Number.isFinite(latency) ? ` / ${latency}MS` : ""}` : "OFFLINE";'
    WRITE JS-LINE FROM '}'
    WRITE JS-LINE FROM 'async function refreshStatuses() {'
    WRITE JS-LINE FROM '  try {'
    WRITE JS-LINE FROM '    const response = await fetch("/api/status", {cache:"no-store", headers:{Accept:"application/json"}});'
    WRITE JS-LINE FROM '    if (!response.ok) throw new Error("status request failed");'
    WRITE JS-LINE FROM '    const payload = await response.json();'
    WRITE JS-LINE FROM '    for (const [key, status] of Object.entries(payload.games || {})) setStatus(key, status.status, status.latencyMs);'
    WRITE JS-LINE FROM '  } catch (_) { for (const key of statusNodes.keys()) setStatus(key, "down"); }'
    WRITE JS-LINE FROM '}'
    WRITE JS-LINE FROM 'refreshStatuses(); setInterval(refreshStatuses, 30000);'.

