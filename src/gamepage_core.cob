>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. GAMEPAGE-CORE.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INPUT-FILE ASSIGN TO DYNAMIC INPUT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS INPUT-STATUS.
    SELECT OUTPUT-FILE ASSIGN TO DYNAMIC OUTPUT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS OUTPUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD INPUT-FILE.
01 INPUT-RECORD PIC X(4096).
FD OUTPUT-FILE.
01 OUTPUT-RECORD PIC X(4096).

WORKING-STORAGE SECTION.
COPY "game_registry.cpy".
01 INPUT-PATH PIC X(512).
01 OUTPUT-PATH PIC X(512).
01 INPUT-STATUS PIC XX.
01 OUTPUT-STATUS PIC XX.
01 ARGUMENT-COUNT PIC 9(4) COMP-5 VALUE 0.
01 END-OF-INPUT PIC X VALUE "N".
01 CONFIG-VALID PIC X VALUE "Y".
01 META-SEEN PIC X VALUE "N".
01 MAINTENANCE-ACTIVE PIC X VALUE "N".
01 READY-FLAG PIC X VALUE "N".
01 CHECKED-AT PIC X(64).
01 MAINTENANCE-TEXT PIC X(32).
01 MINIMUM-LAUNCHABLE-TEXT PIC X(32).
01 MINIMUM-LAUNCHABLE PIC 9(2) VALUE 0.
01 OVERALL-STATE PIC X(32).
01 OPERATING-MODE PIC X(32).
01 RECORD-TYPE PIC X(16).
01 FIELD-1 PIC X(256).
01 FIELD-2 PIC X(256).
01 FIELD-3 PIC X(256).
01 FIELD-4 PIC X(256).
01 FIELD-5 PIC X(256).
01 FIELD-6 PIC X(256).
01 FIELD-7 PIC X(256).
01 FIELD-8 PIC X(256).
01 INPUT-GAME-COUNT PIC 9(2) VALUE 0.
01 INDEX-1 PIC 9(2) VALUE 0.
01 INDEX-2 PIC 9(2) VALUE 0.
01 MATCH-INDEX PIC 9(2) VALUE 0.
01 OBSERVATION-TABLE.
    05 OBSERVATION-ENTRY OCCURS 10 TIMES.
        10 OBS-SEEN PIC X VALUE "N".
        10 OBS-STATE PIC X(16).
        10 OBS-HTTP-STATUS PIC 9(3).
        10 OBS-LATENCY PIC 9(9).
        10 OBS-ERROR PIC X(64).
        10 OBS-ENABLED-TEXT PIC X(32).
        10 OBS-REQUIRED-TEXT PIC X(32).
        10 OBS-MAX-LATENCY-TEXT PIC X(32).
        10 POLICY-ENABLED PIC X VALUE "N".
        10 POLICY-REQUIRED PIC X VALUE "N".
        10 POLICY-MAX-LATENCY PIC 9(6) VALUE 0.
        10 POLICY-STATE PIC X(32).
        10 POLICY-LAUNCHABLE PIC X VALUE "N".
        10 POLICY-REASON PIC X(64).
01 UP-COUNT PIC 9(2) VALUE 0.
01 DOWN-COUNT PIC 9(2) VALUE 0.
01 ENABLED-COUNT PIC 9(2) VALUE 0.
01 REQUIRED-COUNT PIC 9(2) VALUE 0.
01 LAUNCHABLE-COUNT PIC 9(2) VALUE 0.
01 HEALTHY-COUNT PIC 9(2) VALUE 0.
01 SLOW-COUNT PIC 9(2) VALUE 0.
01 DISABLED-COUNT PIC 9(2) VALUE 0.
01 REQUIRED-FAILURE-COUNT PIC 9(2) VALUE 0.
01 BOOLEAN-TEXT PIC X(32).
01 BOOLEAN-NORMALIZED PIC X(32).
01 BOOLEAN-DEFAULT PIC X.
01 BOOLEAN-RESULT PIC X.
01 BOOLEAN-VALID PIC X.
01 NUMBER-TEXT PIC X(256).
01 NUMBER-LENGTH PIC 9(3) VALUE 0.
01 NUMBER-INDEX PIC 9(3) VALUE 0.
01 NUMBER-VALID PIC X VALUE "N".
01 OUTPUT-BUFFER PIC X(4096).
01 OUTPUT-POINTER PIC 9(4) COMP-5 VALUE 1.
01 DISPLAY-NUMBER PIC Z(8)9.
01 DISPLAY-HTTP PIC ZZ9.
01 JSON-BOOLEAN PIC X(5).
01 ENABLED-JSON PIC X(5).
01 REQUIRED-JSON PIC X(5).
01 LAUNCHABLE-JSON PIC X(5).
01 COMMA-TEXT PIC X VALUE SPACE.

PROCEDURE DIVISION.
MAIN.
    ACCEPT ARGUMENT-COUNT FROM ARGUMENT-NUMBER
    IF ARGUMENT-COUNT NOT = 2
        DISPLAY "usage: gamepage-core INPUT OUTPUT" UPON STDERR
        MOVE 2 TO RETURN-CODE
        STOP RUN
    END-IF
    ACCEPT INPUT-PATH FROM ARGUMENT-VALUE
    ACCEPT OUTPUT-PATH FROM ARGUMENT-VALUE
    OPEN INPUT INPUT-FILE
    IF INPUT-STATUS NOT = "00"
        DISPLAY "could not open COBOL decision input" UPON STDERR
        MOVE 3 TO RETURN-CODE
        STOP RUN
    END-IF
    PERFORM READ-INPUT UNTIL END-OF-INPUT = "Y"
    CLOSE INPUT-FILE
    PERFORM EVALUATE-APPLICATION-POLICY
    OPEN OUTPUT OUTPUT-FILE
    IF OUTPUT-STATUS NOT = "00"
        DISPLAY "could not open COBOL decision output" UPON STDERR
        MOVE 4 TO RETURN-CODE
        STOP RUN
    END-IF
    PERFORM WRITE-STATUS-JSON
    CLOSE OUTPUT-FILE
    STOP RUN.

READ-INPUT.
    READ INPUT-FILE
        AT END
            MOVE "Y" TO END-OF-INPUT
        NOT AT END
            PERFORM PARSE-INPUT-RECORD
    END-READ.

PARSE-INPUT-RECORD.
    MOVE SPACES TO RECORD-TYPE FIELD-1 FIELD-2 FIELD-3 FIELD-4
        FIELD-5 FIELD-6 FIELD-7 FIELD-8
    UNSTRING INPUT-RECORD DELIMITED BY "|"
        INTO RECORD-TYPE FIELD-1 FIELD-2 FIELD-3 FIELD-4
             FIELD-5 FIELD-6 FIELD-7 FIELD-8
    END-UNSTRING
    EVALUATE FUNCTION UPPER-CASE(FUNCTION TRIM(RECORD-TYPE))
        WHEN "META"
            PERFORM PARSE-META
        WHEN "GAME"
            PERFORM PARSE-GAME
        WHEN OTHER
            MOVE "N" TO CONFIG-VALID
    END-EVALUATE.

PARSE-META.
    IF META-SEEN = "Y"
        MOVE "N" TO CONFIG-VALID
    END-IF
    MOVE "Y" TO META-SEEN
    MOVE FUNCTION TRIM(FIELD-1) TO CHECKED-AT
    MOVE FUNCTION TRIM(FIELD-2) TO MAINTENANCE-TEXT
    MOVE FUNCTION TRIM(FIELD-3) TO MINIMUM-LAUNCHABLE-TEXT
    IF FUNCTION TRIM(CHECKED-AT) = SPACES
        MOVE "N" TO CONFIG-VALID
    END-IF.

PARSE-GAME.
    MOVE 0 TO MATCH-INDEX
    PERFORM VARYING INDEX-2 FROM 1 BY 1
        UNTIL INDEX-2 > REGISTRY-GAME-COUNT
        IF FUNCTION TRIM(REG-GAME-KEY(INDEX-2)) = FUNCTION TRIM(FIELD-1)
            MOVE INDEX-2 TO MATCH-INDEX
        END-IF
    END-PERFORM
    IF MATCH-INDEX = 0
        MOVE "N" TO CONFIG-VALID
        EXIT PARAGRAPH
    END-IF
    IF OBS-SEEN(MATCH-INDEX) = "Y"
        MOVE "N" TO CONFIG-VALID
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO OBS-SEEN(MATCH-INDEX)
    ADD 1 TO INPUT-GAME-COUNT
    MOVE FUNCTION LOWER-CASE(FUNCTION TRIM(FIELD-2))
        TO OBS-STATE(MATCH-INDEX)
    IF FUNCTION TRIM(OBS-STATE(MATCH-INDEX)) NOT = "up"
        AND FUNCTION TRIM(OBS-STATE(MATCH-INDEX)) NOT = "down"
        MOVE "N" TO CONFIG-VALID
    END-IF

    MOVE FIELD-3 TO NUMBER-TEXT
    PERFORM VALIDATE-NUMBER
    IF NUMBER-VALID = "Y"
        MOVE FUNCTION NUMVAL(NUMBER-TEXT) TO OBS-HTTP-STATUS(MATCH-INDEX)
    ELSE
        MOVE "N" TO CONFIG-VALID
    END-IF

    MOVE FIELD-4 TO NUMBER-TEXT
    PERFORM VALIDATE-NUMBER
    IF NUMBER-VALID = "Y"
        MOVE FUNCTION NUMVAL(NUMBER-TEXT) TO OBS-LATENCY(MATCH-INDEX)
    ELSE
        MOVE "N" TO CONFIG-VALID
    END-IF

    MOVE FUNCTION TRIM(FIELD-5) TO OBS-ERROR(MATCH-INDEX)
    MOVE FUNCTION TRIM(FIELD-6) TO OBS-ENABLED-TEXT(MATCH-INDEX)
    MOVE FUNCTION TRIM(FIELD-7) TO OBS-REQUIRED-TEXT(MATCH-INDEX)
    MOVE FUNCTION TRIM(FIELD-8) TO OBS-MAX-LATENCY-TEXT(MATCH-INDEX).

EVALUATE-APPLICATION-POLICY.
    IF META-SEEN NOT = "Y" OR INPUT-GAME-COUNT NOT = REGISTRY-GAME-COUNT
        MOVE "N" TO CONFIG-VALID
    END-IF
    PERFORM VARYING INDEX-1 FROM 1 BY 1
        UNTIL INDEX-1 > REGISTRY-GAME-COUNT
        IF OBS-SEEN(INDEX-1) NOT = "Y"
            MOVE "N" TO CONFIG-VALID
        END-IF
    END-PERFORM

    MOVE MAINTENANCE-TEXT TO BOOLEAN-TEXT
    MOVE "N" TO BOOLEAN-DEFAULT
    PERFORM RESOLVE-BOOLEAN
    IF BOOLEAN-VALID = "Y"
        MOVE BOOLEAN-RESULT TO MAINTENANCE-ACTIVE
    ELSE
        MOVE "N" TO CONFIG-VALID
    END-IF

    MOVE REGISTRY-DEFAULT-MINIMUM-LAUNCHABLE TO MINIMUM-LAUNCHABLE
    IF FUNCTION TRIM(MINIMUM-LAUNCHABLE-TEXT) NOT = SPACES
        MOVE MINIMUM-LAUNCHABLE-TEXT TO NUMBER-TEXT
        PERFORM VALIDATE-NUMBER
        IF NUMBER-VALID = "Y"
            MOVE FUNCTION NUMVAL(NUMBER-TEXT) TO MINIMUM-LAUNCHABLE
            IF MINIMUM-LAUNCHABLE < 1
                OR MINIMUM-LAUNCHABLE > REGISTRY-GAME-COUNT
                MOVE REGISTRY-DEFAULT-MINIMUM-LAUNCHABLE
                    TO MINIMUM-LAUNCHABLE
                MOVE "N" TO CONFIG-VALID
            END-IF
        ELSE
            MOVE REGISTRY-DEFAULT-MINIMUM-LAUNCHABLE
                TO MINIMUM-LAUNCHABLE
            MOVE "N" TO CONFIG-VALID
        END-IF
    END-IF

    MOVE 0 TO UP-COUNT DOWN-COUNT ENABLED-COUNT REQUIRED-COUNT
        LAUNCHABLE-COUNT HEALTHY-COUNT SLOW-COUNT DISABLED-COUNT
        REQUIRED-FAILURE-COUNT

    PERFORM VARYING INDEX-1 FROM 1 BY 1
        UNTIL INDEX-1 > REGISTRY-GAME-COUNT
        PERFORM RESOLVE-CURRENT-GAME-POLICY
    END-PERFORM

    IF CONFIG-VALID NOT = "Y"
        MOVE 0 TO LAUNCHABLE-COUNT HEALTHY-COUNT SLOW-COUNT DISABLED-COUNT
        MOVE REQUIRED-COUNT TO REQUIRED-FAILURE-COUNT
        PERFORM VARYING INDEX-1 FROM 1 BY 1
            UNTIL INDEX-1 > REGISTRY-GAME-COUNT
            MOVE "invalid" TO POLICY-STATE(INDEX-1)
            MOVE "N" TO POLICY-LAUNCHABLE(INDEX-1)
            MOVE "configuration-invalid" TO POLICY-REASON(INDEX-1)
        END-PERFORM
    END-IF

    IF CONFIG-VALID NOT = "Y"
        MOVE "configuration-error" TO OVERALL-STATE
        MOVE "invalid" TO OPERATING-MODE
        MOVE "N" TO READY-FLAG
    ELSE
        IF MAINTENANCE-ACTIVE = "Y"
            MOVE "maintenance" TO OVERALL-STATE
            MOVE "maintenance" TO OPERATING-MODE
            MOVE "N" TO READY-FLAG
        ELSE
            IF REQUIRED-FAILURE-COUNT > 0
                OR LAUNCHABLE-COUNT < MINIMUM-LAUNCHABLE
                MOVE "degraded" TO OVERALL-STATE
                MOVE "degraded" TO OPERATING-MODE
                MOVE "N" TO READY-FLAG
            ELSE
                MOVE "Y" TO READY-FLAG
                IF SLOW-COUNT > 0 OR DOWN-COUNT > 0 OR DISABLED-COUNT > 0
                    MOVE "degraded" TO OVERALL-STATE
                    MOVE "degraded" TO OPERATING-MODE
                ELSE
                    MOVE "ok" TO OVERALL-STATE
                    MOVE "normal" TO OPERATING-MODE
                END-IF
            END-IF
        END-IF
    END-IF.

RESOLVE-CURRENT-GAME-POLICY.
    MOVE OBS-ENABLED-TEXT(INDEX-1) TO BOOLEAN-TEXT
    MOVE REG-GAME-DEFAULT-ENABLED(INDEX-1) TO BOOLEAN-DEFAULT
    PERFORM RESOLVE-BOOLEAN
    IF BOOLEAN-VALID = "Y"
        MOVE BOOLEAN-RESULT TO POLICY-ENABLED(INDEX-1)
    ELSE
        MOVE "N" TO CONFIG-VALID
    END-IF

    MOVE OBS-REQUIRED-TEXT(INDEX-1) TO BOOLEAN-TEXT
    MOVE REG-GAME-DEFAULT-REQUIRED(INDEX-1) TO BOOLEAN-DEFAULT
    PERFORM RESOLVE-BOOLEAN
    IF BOOLEAN-VALID = "Y"
        MOVE BOOLEAN-RESULT TO POLICY-REQUIRED(INDEX-1)
    ELSE
        MOVE "N" TO CONFIG-VALID
    END-IF

    MOVE REG-GAME-DEFAULT-MAX-LATENCY(INDEX-1)
        TO POLICY-MAX-LATENCY(INDEX-1)
    IF FUNCTION TRIM(OBS-MAX-LATENCY-TEXT(INDEX-1)) NOT = SPACES
        MOVE OBS-MAX-LATENCY-TEXT(INDEX-1) TO NUMBER-TEXT
        PERFORM VALIDATE-NUMBER
        IF NUMBER-VALID = "Y"
            MOVE FUNCTION NUMVAL(NUMBER-TEXT)
                TO POLICY-MAX-LATENCY(INDEX-1)
            IF POLICY-MAX-LATENCY(INDEX-1) < 1
                MOVE REG-GAME-DEFAULT-MAX-LATENCY(INDEX-1)
                    TO POLICY-MAX-LATENCY(INDEX-1)
                MOVE "N" TO CONFIG-VALID
            END-IF
        ELSE
            MOVE REG-GAME-DEFAULT-MAX-LATENCY(INDEX-1)
                TO POLICY-MAX-LATENCY(INDEX-1)
            MOVE "N" TO CONFIG-VALID
        END-IF
    END-IF

    IF FUNCTION TRIM(OBS-STATE(INDEX-1)) = "up"
        ADD 1 TO UP-COUNT
    ELSE
        ADD 1 TO DOWN-COUNT
    END-IF
    IF POLICY-ENABLED(INDEX-1) = "Y"
        ADD 1 TO ENABLED-COUNT
    END-IF
    IF POLICY-REQUIRED(INDEX-1) = "Y"
        ADD 1 TO REQUIRED-COUNT
    END-IF

    IF CONFIG-VALID NOT = "Y"
        MOVE "invalid" TO POLICY-STATE(INDEX-1)
        MOVE "N" TO POLICY-LAUNCHABLE(INDEX-1)
        MOVE "configuration-invalid" TO POLICY-REASON(INDEX-1)
    ELSE
        IF MAINTENANCE-ACTIVE = "Y"
            MOVE "maintenance" TO POLICY-STATE(INDEX-1)
            MOVE "N" TO POLICY-LAUNCHABLE(INDEX-1)
            MOVE "maintenance" TO POLICY-REASON(INDEX-1)
        ELSE
            IF POLICY-ENABLED(INDEX-1) NOT = "Y"
                MOVE "disabled" TO POLICY-STATE(INDEX-1)
                MOVE "N" TO POLICY-LAUNCHABLE(INDEX-1)
                MOVE "disabled" TO POLICY-REASON(INDEX-1)
                ADD 1 TO DISABLED-COUNT
                IF POLICY-REQUIRED(INDEX-1) = "Y"
                    ADD 1 TO REQUIRED-FAILURE-COUNT
                END-IF
            ELSE
                IF FUNCTION TRIM(OBS-STATE(INDEX-1)) NOT = "up"
                    MOVE "down" TO POLICY-STATE(INDEX-1)
                    MOVE "N" TO POLICY-LAUNCHABLE(INDEX-1)
                    IF FUNCTION TRIM(OBS-ERROR(INDEX-1)) = SPACES
                        MOVE "unavailable" TO POLICY-REASON(INDEX-1)
                    ELSE
                        MOVE FUNCTION TRIM(OBS-ERROR(INDEX-1))
                            TO POLICY-REASON(INDEX-1)
                    END-IF
                    IF POLICY-REQUIRED(INDEX-1) = "Y"
                        ADD 1 TO REQUIRED-FAILURE-COUNT
                    END-IF
                ELSE
                    MOVE "Y" TO POLICY-LAUNCHABLE(INDEX-1)
                    ADD 1 TO LAUNCHABLE-COUNT
                    IF OBS-LATENCY(INDEX-1) > POLICY-MAX-LATENCY(INDEX-1)
                        MOVE "slow" TO POLICY-STATE(INDEX-1)
                        MOVE "latency-threshold-exceeded"
                            TO POLICY-REASON(INDEX-1)
                        ADD 1 TO SLOW-COUNT
                        IF POLICY-REQUIRED(INDEX-1) = "Y"
                            ADD 1 TO REQUIRED-FAILURE-COUNT
                        END-IF
                    ELSE
                        MOVE "healthy" TO POLICY-STATE(INDEX-1)
                        MOVE "ready" TO POLICY-REASON(INDEX-1)
                        ADD 1 TO HEALTHY-COUNT
                    END-IF
                END-IF
            END-IF
        END-IF
    END-IF.

RESOLVE-BOOLEAN.
    MOVE "Y" TO BOOLEAN-VALID
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(BOOLEAN-TEXT))
        TO BOOLEAN-NORMALIZED
    EVALUATE FUNCTION TRIM(BOOLEAN-NORMALIZED)
        WHEN SPACES
            MOVE BOOLEAN-DEFAULT TO BOOLEAN-RESULT
        WHEN "1"
        WHEN "TRUE"
        WHEN "YES"
        WHEN "ON"
        WHEN "Y"
            MOVE "Y" TO BOOLEAN-RESULT
        WHEN "0"
        WHEN "FALSE"
        WHEN "NO"
        WHEN "OFF"
        WHEN "N"
            MOVE "N" TO BOOLEAN-RESULT
        WHEN OTHER
            MOVE "N" TO BOOLEAN-RESULT
            MOVE "N" TO BOOLEAN-VALID
    END-EVALUATE.

VALIDATE-NUMBER.
    MOVE FUNCTION TRIM(NUMBER-TEXT) TO NUMBER-TEXT
    COMPUTE NUMBER-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(NUMBER-TEXT))
    IF NUMBER-LENGTH = 0
        MOVE "N" TO NUMBER-VALID
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO NUMBER-VALID
    PERFORM VARYING NUMBER-INDEX FROM 1 BY 1
        UNTIL NUMBER-INDEX > NUMBER-LENGTH
        IF NUMBER-TEXT(NUMBER-INDEX:1) < "0"
            OR NUMBER-TEXT(NUMBER-INDEX:1) > "9"
            MOVE "N" TO NUMBER-VALID
        END-IF
    END-PERFORM.

WRITE-STATUS-JSON.
    WRITE OUTPUT-RECORD FROM "{"
    PERFORM WRITE-OVERALL-LINE
    PERFORM WRITE-READY-LINE
    PERFORM WRITE-MODE-LINE
    WRITE OUTPUT-RECORD FROM '  "decisionEngine":"gnucobol",'
    PERFORM WRITE-CHECKED-AT-LINE
    PERFORM WRITE-POLICY-LINE
    PERFORM WRITE-SUMMARY-LINE
    WRITE OUTPUT-RECORD FROM '  "games":{'
    PERFORM VARYING INDEX-1 FROM 1 BY 1
        UNTIL INDEX-1 > REGISTRY-GAME-COUNT
        PERFORM WRITE-GAME-LINE
    END-PERFORM
    WRITE OUTPUT-RECORD FROM "  }"
    WRITE OUTPUT-RECORD FROM "}".

WRITE-OVERALL-LINE.
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '  "overall":"' DELIMITED BY SIZE
        FUNCTION TRIM(OVERALL-STATE) DELIMITED BY SIZE
        '",' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    WRITE OUTPUT-RECORD FROM OUTPUT-BUFFER.

WRITE-READY-LINE.
    IF READY-FLAG = "Y"
        MOVE "true" TO JSON-BOOLEAN
    ELSE
        MOVE "false" TO JSON-BOOLEAN
    END-IF
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '  "ready":' DELIMITED BY SIZE
        FUNCTION TRIM(JSON-BOOLEAN) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    WRITE OUTPUT-RECORD FROM OUTPUT-BUFFER.

WRITE-MODE-LINE.
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '  "mode":"' DELIMITED BY SIZE
        FUNCTION TRIM(OPERATING-MODE) DELIMITED BY SIZE
        '",' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    WRITE OUTPUT-RECORD FROM OUTPUT-BUFFER.

WRITE-CHECKED-AT-LINE.
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '  "checkedAt":"' DELIMITED BY SIZE
        FUNCTION TRIM(CHECKED-AT) DELIMITED BY SIZE
        '",' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    WRITE OUTPUT-RECORD FROM OUTPUT-BUFFER.

WRITE-POLICY-LINE.
    MOVE MINIMUM-LAUNCHABLE TO DISPLAY-NUMBER
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '  "policy":{"minimumLaunchableGames":' DELIMITED BY SIZE
        FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"requiredFailures":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    MOVE REQUIRED-FAILURE-COUNT TO DISPLAY-NUMBER
    STRING
        FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        "}," DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    WRITE OUTPUT-RECORD FROM OUTPUT-BUFFER.

WRITE-SUMMARY-LINE.
    MOVE REGISTRY-GAME-COUNT TO DISPLAY-NUMBER
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '  "summary":{"total":' DELIMITED BY SIZE
        FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"up":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    MOVE UP-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"down":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE DOWN-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"enabled":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE ENABLED-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"required":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE REQUIRED-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"launchable":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE LAUNCHABLE-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"healthy":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE HEALTHY-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"slow":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE SLOW-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"disabled":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    MOVE DISABLED-COUNT TO DISPLAY-NUMBER
    STRING FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        "}," DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER END-STRING
    WRITE OUTPUT-RECORD FROM OUTPUT-BUFFER.

WRITE-GAME-LINE.
    IF INDEX-1 < REGISTRY-GAME-COUNT
        MOVE "," TO COMMA-TEXT
    ELSE
        MOVE SPACE TO COMMA-TEXT
    END-IF
    IF POLICY-ENABLED(INDEX-1) = "Y"
        MOVE "true" TO ENABLED-JSON
    ELSE
        MOVE "false" TO ENABLED-JSON
    END-IF
    IF POLICY-REQUIRED(INDEX-1) = "Y"
        MOVE "true" TO REQUIRED-JSON
    ELSE
        MOVE "false" TO REQUIRED-JSON
    END-IF
    IF POLICY-LAUNCHABLE(INDEX-1) = "Y"
        MOVE "true" TO LAUNCHABLE-JSON
    ELSE
        MOVE "false" TO LAUNCHABLE-JSON
    END-IF
    MOVE OBS-HTTP-STATUS(INDEX-1) TO DISPLAY-HTTP
    MOVE OBS-LATENCY(INDEX-1) TO DISPLAY-NUMBER
    MOVE SPACES TO OUTPUT-BUFFER
    MOVE 1 TO OUTPUT-POINTER
    STRING
        '    "' DELIMITED BY SIZE
        FUNCTION TRIM(REG-GAME-KEY(INDEX-1)) DELIMITED BY SIZE
        '":{"name":"' DELIMITED BY SIZE
        FUNCTION TRIM(REG-GAME-NAME(INDEX-1)) DELIMITED BY SIZE
        '","path":"' DELIMITED BY SIZE
        FUNCTION TRIM(REG-GAME-PREFIX(INDEX-1)) DELIMITED BY SIZE
        '/","status":"' DELIMITED BY SIZE
        FUNCTION TRIM(OBS-STATE(INDEX-1)) DELIMITED BY SIZE
        '","policyState":"' DELIMITED BY SIZE
        FUNCTION TRIM(POLICY-STATE(INDEX-1)) DELIMITED BY SIZE
        '","httpStatus":' DELIMITED BY SIZE
        FUNCTION TRIM(DISPLAY-HTTP) DELIMITED BY SIZE
        ',"latencyMs":' DELIMITED BY SIZE
        FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"error":"' DELIMITED BY SIZE
        FUNCTION TRIM(OBS-ERROR(INDEX-1)) DELIMITED BY SIZE
        '","enabled":' DELIMITED BY SIZE
        FUNCTION TRIM(ENABLED-JSON) DELIMITED BY SIZE
        ',"required":' DELIMITED BY SIZE
        FUNCTION TRIM(REQUIRED-JSON) DELIMITED BY SIZE
        ',"maxLatencyMs":' DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
    END-STRING
    MOVE POLICY-MAX-LATENCY(INDEX-1) TO DISPLAY-NUMBER
    STRING
        FUNCTION TRIM(DISPLAY-NUMBER) DELIMITED BY SIZE
        ',"launchable":' DELIMITED BY SIZE
        FUNCTION TRIM(LAUNCHABLE-JSON) DELIMITED BY SIZE
        ',"reason":"' DELIMITED BY SIZE
        FUNCTION TRIM(POLICY-REASON(INDEX-1)) DELIMITED BY SIZE
        '"}' DELIMITED BY SIZE
        FUNCTION TRIM(COMMA-TEXT) DELIMITED BY SIZE
        INTO OUTPUT-BUFFER WITH POINTER OUTPUT-POINTER
